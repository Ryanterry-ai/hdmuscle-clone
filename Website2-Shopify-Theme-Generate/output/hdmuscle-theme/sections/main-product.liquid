{% comment %}
  Main Product Section - Morphogen Nutrition Style
{% endcomment %}

<style>
  .product {
    padding: 40px;
    max-width: 1400px;
    margin: 0 auto;
  }
  .product__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }
  .product__media {
    position: relative;
    background: #f5f5f5;
    aspect-ratio: 1;
  }
  .product__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product__gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 10px;
  }
  .product__gallery-image {
    aspect-ratio: 1;
    background: #f5f5f5;
    cursor: pointer;
  }
  .product__gallery-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product__info {
    padding: 20px 0;
  }
  .product__title {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 15px;
    line-height: 1.2;
  }
  .product__price {
    font-size: 24px;
    margin-bottom: 20px;
  }
  .product__price .price--compare {
    color: #888;
    text-decoration: line-through;
    margin-left: 10px;
  }
  .product__description {
    font-size: 14px;
    color: #666;
    margin-bottom: 30px;
    line-height: 1.8;
  }
  .product-form {
    margin-top: 20px;
  }
  .product-form__submit {
    width: 100%;
    padding: 18px;
    background: #1a1a1a;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    border: none;
    cursor: pointer;
    border-radius: 50px;
    transition: background-color 0.3s;
  }
  .product-form__submit:hover {
    background: #333;
  }
  @media (max-width: 768px) {
    .product__grid { grid-template-columns: 1fr; gap: 30px; }
  }
</style>

<div class="product section-{{ section.id }}">
  <div class="product__grid">
    <div class="product__media">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'product__featured-image' }}
      {%- else -%}
        <div class="product__media-placeholder"></div>
      {%- endif -%}
      
      {%- if product.images.size > 1 -%}
      <div class="product__gallery">
        {%- for image in product.images limit: 4 -%}
          <div class="product__gallery-image">
            {{ image | image_url: width: 200 | image_tag: loading: 'lazy' }}
          </div>
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>
    
    <div class="product__info">
      <h1 class="product__title">{{ product.title }}</h1>
      
      <div class="product__price">
        <span class="price">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="price price--compare">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
      </div>
      
      <div class="product__description">
        {{ product.description }}
      </div>
      
      {%- form 'product', product, class: 'product-form' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        
        <button type="submit" name="add" class="product-form__submit">
          {{ 'products.product.add_to_cart' | t }}
        </button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product information",
  "settings": []
}
{% endschema %}