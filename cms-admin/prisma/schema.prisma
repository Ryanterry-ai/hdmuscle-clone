generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String?
  role          String    @default("CUSTOMER")
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}

model Site {
  id              String    @id @default(uuid())
  name            String
  domain          String    @unique
  platform        String    @default("shopify")
  platform_url    String?
  access_token    String?
  logo            String?
  favicon         String?
  plan            String    @default("free")
  is_active       Boolean   @default(true)
  last_synced_at  DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@map("sites")
}

model Product {
  id              String    @id @default(uuid())
  handle          String    @unique
  title           String
  description     String?
  description_html String?
  price           Decimal   @db.Decimal(10, 2)
  compare_at_price Decimal?  @db.Decimal(10, 2)
  cost_per_item   Decimal?  @db.Decimal(10, 2)
  weight          Float?
  weight_unit     String?
  is_active       Boolean   @default(true)
  is_featured     Boolean   @default(false)
  is_taxable      Boolean   @default(true)
  tax_rate        Float?
  sku             String?   @unique
  barcode         String?
  inventory       Int       @default(0)
  track_inventory Boolean   @default(true)
  seo_title       String?
  seo_description String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  images       ProductImage[]
  collections  ProductCollection[]
  orderItems   OrderItem[]

  @@map("products")
}

model ProductImage {
  id          String  @id @default(uuid())
  product_id  String
  url         String
  alt_text    String?
  sort_order  Int     @default(0)
  created_at  DateTime @default(now())

  product     Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Collection {
  id            String    @id @default(uuid())
  handle        String    @unique
  title         String
  description   String?
  image         String?
  parent_id     String?
  sort_order    Int       @default(0)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  products      ProductCollection[]
  children      Collection[]        @relation("CollectionHierarchy")
  parent        Collection?         @relation("CollectionHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)

  @@map("collections")
}

model ProductCollection {
  id            String  @id @default(uuid())
  product_id    String
  collection_id String

  product    Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collection_id], references: [id], onDelete: Cascade)

  @@unique([product_id, collection_id])
  @@map("product_collections")
}

model Customer {
  id              String    @id @default(uuid())
  email           String    @unique
  first_name      String?
  last_name       String?
  phone           String?
  accept_marketing Boolean   @default(false)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  addresses       Address[]
  orders          Order[]

  @@map("customers")
}

model Address {
  id          String    @id @default(uuid())
  customer_id String
  first_name  String?
  last_name   String?
  address1    String
  address2    String?
  city        String
  state       String
  zip         String
  country     String    @default("India")
  phone       String?
  is_default  Boolean   @default(false)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  customer    Customer  @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Order {
  id                String    @id @default(uuid())
  order_number      String    @unique
  customer_id       String?
  email             String
  first_name        String?
  last_name         String?
  phone             String?
  subtotal          Decimal   @db.Decimal(10, 2)
  shipping          Decimal   @default(0) @db.Decimal(10, 2)
  tax               Decimal   @default(0) @db.Decimal(10, 2)
  discount          Decimal   @default(0) @db.Decimal(10, 2)
  total             Decimal   @db.Decimal(10, 2)
  status            String    @default("PENDING")
  fulfillment_status String   @default("NONE")
  payment_status    String    @default("PENDING")
  shipping_address   String?
  billing_address    String?
  notes             String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  customer         Customer?  @relation(fields: [customer_id], references: [id])
  items            OrderItem[]
  payments         Payment[]

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  order_id    String
  product_id  String?
  variant_id  String?
  title       String
  sku         String?
  price       Decimal @db.Decimal(10, 2)
  quantity    Int
  total       Decimal @db.Decimal(10, 2)

  order       Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [product_id], references: [id])

  @@map("order_items")
}

model Payment {
  id              String    @id @default(uuid())
  order_id        String
  razorpay_id     String    @unique
  amount          Decimal   @db.Decimal(10, 2)
  status          String
  method          String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  order           Order     @relation(fields: [order_id], references: [id])

  @@map("payments")
}

model Discount {
  id            String         @id @default(uuid())
  code          String         @unique
  title         String
  description   String?
  type          String
  value         Decimal        @db.Decimal(10, 2)
  min_order_value Decimal?     @db.Decimal(10, 2)
  max_discount   Decimal?      @db.Decimal(10, 2)
  usage_limit   Int?
  used_count    Int            @default(0)
  starts_at     DateTime?
  expires_at    DateTime?
  status        String         @default("ACTIVE")
  is_auto_apply Boolean        @default(false)
  product_ids   String?
  collection_ids String?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  @@map("discounts")
}

model Affiliate {
  id           String    @id @default(uuid())
  code         String    @unique
  name         String
  email        String?
  commission   Decimal    @default(10) @db.Decimal(5, 2)
  is_active    Boolean   @default(true)
  orders_count Int       @default(0)
  total_earnings Decimal @default(0) @db.Decimal(10, 2)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@map("affiliates")
}

model Media {
  id          String   @id @default(uuid())
  url         String
  filename    String
  mime_type   String?
  size        Int?
  alt_text    String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("media")
}

model Popup {
  id            String    @id @default(uuid())
  title         String
  content       String
  trigger_type  String    @default("TIME")
  trigger_value Int       @default(5)
  is_active     Boolean   @default(true)
  status        String    @default("ACTIVE")
  starts_at     DateTime?
  expires_at    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@map("popups")
}

model Newsletter {
  id           String    @id @default(uuid())
  email        String    @unique
  is_active    Boolean   @default(true)
  source       String?
  created_at   DateTime  @default(now())

  @@map("newsletter")
}

model Section {
  id            String    @id @default(uuid())
  section_key   String    @unique
  section_type  String
  title         String?
  content       String
  position      Int       @default(0)
  status        String    @default("DRAFT")
  styling       String?
  version       Int       @default(1)
  published_at  DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@map("sections")
}

model Setting {
  id          String    @id @default(uuid())
  key         String    @unique
  value       String
  description String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("settings")
}

model SEO {
  id          String    @id @default(uuid())
  page        String    @unique
  title       String?
  description String?
  keywords    String?
  og_image    String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("seo")
}

// =====================
// PAYLOAD LAYER MODELS
// =====================

model GlobalSettings {
  id                    String    @id @default(uuid())
  store_name             String    @default("My Store")
  store_email           String?
  store_phone           String?
  store_address         String?
  currency              String    @default("INR")
  timezone              String    @default("Asia/Kolkata")
  logo                  String?
  favicon               String?
  primary_color        String    @default("#f59e0b")
  accent_color          String    @default("#ea580c")
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@map("global_settings")
}

model AnnouncementBar {
  id          String    @id @default(uuid())
  message     String
  link        String?
  is_active   Boolean   @default(true)
  page_ids    String?
  starts_at   DateTime?
  expires_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("announcement_bars")
}

model Navigation {
  id          String    @id @default(uuid())
  location    String    @unique // "header" | "footer" | "mobile"
  title       String?
  links       String    // JSON array of {label, url, children[]}
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("navigations")
}

model Page {
  id          String    @id @default(uuid())
  title       String
  handle      String    @unique
  content     String?
  excerpt     String?
  featured_image String?
  is_active   Boolean   @default(true)
  is_featured Boolean   @default(false)
  template    String    @default("default")
  meta_title  String?
  meta_description String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("pages")
}

model HomepageSection {
  id            String    @id @default(uuid())
  section_key   String    @unique
  section_type  String    // "hero" | "featured-products" | "brand-story" | "banner" | "testimonials" | "cta" | "newsletter"
  title         String?
  content       String    // JSON content block
  settings      String?   // JSON settings (background, colors, etc)
  position      Int       @default(0)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@map("homepage_sections")
}

model CartDrawerSettings {
  id              String    @id @default(uuid())
  promo_headline  String?
  promo_message  String?
  promo_image    String?
  show_promo     Boolean   @default(true)
  upsell_products String?   // JSON array of product IDs
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@map("cart_drawer_settings")
}

model SearchSettings {
  id            String    @id @default(uuid())
  placeholder   String    @default("Search products...")
  show_trending Boolean   @default(true)
  trending_terms String?   // JSON array
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@map("search_settings")
}

model FooterSettings {
  id              String    @id @default(uuid())
  description    String?
  show_newsletter Boolean   @default(true)
  columns         String?   // JSON for footer columns
  copyright       String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@map("footer_settings")
}

model FormSubmission {
  id          String    @id @default(uuid())
  form_id     String
  email      String?
  data       String    // JSON
  source     String?
  status     String    @default("NEW")
  created_at DateTime  @default(now())

  @@map("form_submissions")
}

model Campaign {
  id            String    @id @default(uuid())
  name         String
  subject      String?
  content     String?
  list_id      String?
  status      String    @default("DRAFT")
  sent_at     DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("campaigns")
}

model EmailList {
  id           String    @id @default(uuid())
  name         String
  description String?
  is_active    Boolean   @default(true)
  subscribers Int       @default(0)
  created_at   DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("email_lists")
}
