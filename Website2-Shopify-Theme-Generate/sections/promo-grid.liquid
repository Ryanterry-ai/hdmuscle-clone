{% comment %}
  Morphogen Nutrition Hero/Promo Grid Section
  Converted from cloned website - 6 category grid
{% endcomment %}

<div class="promo-grid-section section-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin title-wrapper--self-padded-mobile title-wrapper--self-padded">
        <h2 class="title">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}

    <div class="promo-grid grid grid--1-col grid--2-col-tablet grid--3-col-desktop">
      {%- for i in (1..6) -%}
        {%- assign image_key = 'image_' | append: i -%}
        {%- assign heading_key = 'heading_' | append: i -%}
        {%- assign subtext_key = 'subtext_' | append: i -%}
        {%- assign link_key = 'link_' | append: i -%}

        {%- if section.settings[heading_key] != blank -%}
          <div class="promo-grid__item grid__item">
            <a href="{{ section.settings[link_key] }}" class="promo-card">
              {%- if section.settings[image_key] != blank -%}
                <div class="promo-card__media">
                  {{ section.settings[image_key] | image_url: width: 600 | image_tag: loading: 'lazy' }}
                </div>
              {%- else -%}
                <div class="promo-card__media promo-card__media--placeholder">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" fill="none">
                    <rect width="600" height="600" fill="#f5f5f5"/>
                    <path d="M300 150c-83 0-150 67-150 150s67 150 150 150 150-67 150-150-67-150-150-150z" fill="#e5e5e5"/>
                    <path d="M250 225h100v100H250z" fill="#ccc"/>
                    <path d="M200 375l50-50h100l50 50H200z" fill="#ccc"/>
                  </svg>
                </div>
              {%- endif -%}
              <div class="promo-card__content">
                <div class="promo-card__info">
                  <h3 class="promo-card__title">{{ section.settings[heading_key] }}</h3>
                  {%- if section.settings[subtext_key] != blank -%}
                    <p class="promo-card__subtitle">{{ section.settings[subtext_key] }}</p>
                  {%- endif -%}
                  <span class="promo-card__button button button--secondary">{{ 'View All' }}</span>
                </div>
              </div>
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- style -%}
  .promo-grid-section {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .promo-grid-section {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .promo-grid {
    gap: {{ section.settings.gap }}px;
  }

  .promo-card {
    display: block;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    height: 100%;
  }

  .promo-card__media {
    position: relative;
    overflow: hidden;
  }

  .promo-card__media img {
    width: 100%;
    height: auto;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .promo-card:hover .promo-card__media img {
    transform: scale(1.05);
  }

  .promo-card__media--placeholder {
    background-color: #f0f0f0;
    aspect-ratio: 4/3;
  }

  .promo-card__content {
    padding: 15px 0;
  }

  .promo-card__info {
    text-align: center;
  }

  .promo-card__title {
    font-size: 18px;
    font-weight: 600;
    color: #1c1d1d;
    margin: 0 0 5px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .promo-card__subtitle {
    font-size: 14px;
    color: #666;
    margin: 0 0 10px;
  }

  .promo-card__button {
    background-color: #c20000;
    color: #fff;
    border: none;
    border-radius: 50px;
    padding: 8px 20px;
    font-size: 12px;
  }
{%- endstyle -%}

