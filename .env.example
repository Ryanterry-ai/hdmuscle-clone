# Storefront + CMS Configuration
# Copy this file to .env.local and update the values

# Public root domain for metadata/canonical URLs
NEXT_PUBLIC_SITE_URL=https://hdmuscle.in

# CMS API base URL consumed by the storefront server routes
CMS_API=https://cms.hdmuscle.in/api

# Optional explicit published endpoint override
# CMS_STOREFRONT_PUBLISHED_URL=https://cms.hdmuscle.in/api/storefront/published

# Optional browser-side CMS API base (if needed by client components)
# NEXT_PUBLIC_CMS_API_URL=https://cms.hdmuscle.in/api
