{% comment %}
  Morphogen Nutrition Newsletter Section
  Converted from cloned website
{% endcomment %}

<div class="newsletter newsletter--{{ section.settings.layout }} {% if section.settings.enable_background %}newsletter--bg{% endif %}">
  <div class="newsletter__wrapper page-width">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 class="newsletter__heading">{{ block.settings.heading }}</h2>
        {%- when 'text' -%}
          <div class="newsletter__subheading rte">
            {{ block.settings.text }}
          </div>
      {%- endcase -%}
    {%- endfor -%}

    {%- form 'customer', id: 'ContactNewsletter', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter__field-wrapper">
        <div class="field">
          <input
            id="NewsletterForm--{{ section.id }}"
            type="email"
            name="contact[email]"
            class="field__input"
            value="{{ form.email }}"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              autofocus
              aria-invalid="true"
              aria-describedby="NewsletterError--{{ section.id }}"
            {% endif %}
            placeholder="{{ 'general.newsletter.label' | t }}"
            required
          >
          <label class="field__label" for="NewsletterForm--{{ section.id }}">
            {{ 'general.newsletter.label' | t }}
          </label>
          <button type="submit" class="newsletter__button field__button" name="commit" aria-label="{{ 'general.newsletter.button_label' | t }}">
            {% render 'icon-arrow' %}
          </button>
        </div>
        {%- if form.errors -%}
          <small class="newsletter__message form__message" id="NewsletterError--{{ section.id }}">
            {% render 'icon-error' %}
            {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}.
          </small>
        {%- endif -%}
      </div>
      {%- if form.posted_successfully? -%}
        <h3 class="newsletter-form__message newsletter-form__message--success form__message" id="NewsletterSuccess--{{ section.id }}" tabindex="-1" autofocus>
          {% render 'icon-success' %}
          {{ 'general.newsletter.success' | t }}
        </h3>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{%- style -%}
  .newsletter {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }

  .newsletter--bg {
    border: 1px solid {{ section.settings.border_color }};
  }

  .newsletter__wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    text-align: {{ section.settings.text_align }};
  }

  .newsletter__heading {
    margin-bottom: 1rem;
  }

  .newsletter__subheading {
    margin-bottom: 2rem;
  }

  .field__input {
    background-color: transparent;
    border-color: {{ section.settings.input_border_color }};
  }

  .field__input:focus {
    border-color: {{ section.settings.accent_color }};
  }

  .newsletter__button {
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
  }

  @media screen and (min-width: 750px) {
    .newsletter {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Email signup",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "single", "label": "Single column" },
        { "value": "double", "label": "Double column" }
      ],
      "default": "single",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "text_align",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center",
      "label": "Text alignment"
    },
    {
      "type": "checkbox",
      "id": "enable_background",
      "default": false,
      "label": "Show background"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 400,
      "max": 800,
      "step": 50,
      "default": 500,
      "label": "Max width"
    },
    {
      "type": "color",
      "id": "bg_color",
      "default": "#f5f5f5",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#1c1d1d",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "border_color",
      "default": "#e8e8e1",
      "label": "Border color"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "default": "#e8e8e1",
      "label": "Input border color"
    },
    {
      "type": "color",
      "id": "accent_color",
      "default": "#1c1d1d",
      "label": "Accent color"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "default": "#1c1d1d",
      "label": "Button background"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "default": "#ffffff",
      "label": "Button text"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.header_content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Subscribe to our emails",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Be the first to know about new collections and exclusive offers.</p>",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Email signup",
      "blocks": [
        { "type": "heading" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}