# Upgraded.co.in Product Data Extraction - Environment Variables

# Source websites (approved only)
EXTRACTION_SOURCE_URL=
EXTRACTION_MAX_PRODUCTS=50

# Rate limiting
DOWNLOAD_CONCURRENCY=5
REQUEST_DELAY_MS=1000

# Image settings
IMAGE_MAX_WIDTH=1200
IMAGE_MAX_HEIGHT=1200
IMAGE_QUALITY=85
IMAGE_FORMAT=webp

# Output paths
DATA_DIR=data
EXPORTS_DIR=exports
IMAGES_DIR=public/product-images
LOGS_DIR=logs

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=60000

# Validation
ALLOW_MISSING_IMAGES=false
REQUIRE_FSSAI=true
