{% comment %}
  Product Card Placeholder Snippet
{% endcomment %}

<div class="product-card product-card--placeholder">
  <div class="product-card__media">
    {{ 'product-' | append: index | placeholder_svg_tag: 'placeholder-svg product-card__placeholder' }}
  </div>
  <div class="product-card__info">
    <h3 class="product-card__title">Product {{ index }}</h3>
    <div class="product-card__price">
      <span class="price">$0.00</span>
    </div>
  </div>
</div>